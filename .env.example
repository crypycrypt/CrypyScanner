# Copy to .env and fill values
DATABASE_URL=postgresql://user:password@localhost:5432/whaleradar
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_a_long_secret

# Telegram notify (paper trading: ENTRY/EXIT ke topik 2, likuidasi/circuit breaker ke topik 294)
# chatId -1004431059985 sudah hardcoded di lib/telegramNotify.ts
TELEGRAM_BOT_TOKEN=8782357681:AAF_qmCahbm4NnNpQInK1w7dmHd937_elrI

# Sinyal Radar Meme ke Telegram (menu Meme's -> RADAR). Memakai TELEGRAM_BOT_TOKEN
# + chatId yang sama seperti di atas. Setiap token radar ber-sinyal kuat dikirim
# SEKALI (foto logo + caption + tombol GMGN/DexScreener/X/Copy CA) dan tidak
# pernah dikirim ulang (dedup permanen di .data/meme-telegram-sent.json).
MEME_TELEGRAM_ALERTS=true
# Topik forum khusus Meme's (dari link topik yang dibagikan user). 0 = kirim tanpa topik.
TELEGRAM_MEME_TOPIC_ID=21662
# Ambang sinyal kuat (opsional, default sudah disetel di lib/meme/memeTelegramAlert.ts):
# MEME_TG_MIN_AI_SCORE=65
# MEME_TG_MIN_LIQUIDITY=5000
# MEME_TG_MAX_PER_CYCLE=4

# Sinyal BRUTAL FUTURES ke Telegram (Dashboard -> panel BRUTAL FUTURES). Hanya
# sinyal berstatus EXECUTE (termasuk pending order yang trigger-nya baru
# tersentuh) yang dikirim: teks Entry/SL/TP1/TP2/R:R + skor + alasan + tombol
# TradingView. Kombinasi symbol+side yang sama tidak dikirim ulang selama
# cooldown (dedup persisten di .data/brutal-telegram-sent.json).
BRUTAL_TELEGRAM_ALERTS=true
# Topik forum untuk alert futures (default 2 = topik TRADE). 0 = tanpa topik.
BRUTAL_TELEGRAM_TOPIC_ID=2
# Jendela cooldown dedup dalam jam (default 4; minimum 0.5):
# BRUTAL_TG_COOLDOWN_HOURS=4
# Maksimum pesan per siklus dispatch (default 3):
# BRUTAL_TG_MAX_PER_CYCLE=3

# Sinyal Stock Scanner (menu Stocks -> IDX Stocks / US Stocks) ke Telegram.
# Memakai TELEGRAM_BOT_TOKEN + chatId yang sama. Dikirim setelah tiap siklus
# scan (~20 menit) selesai, bukan per-request. Kombinasi market+ticker+arah
# tidak dikirim ulang selama cooldown (dedup persisten di
# .data/stock-telegram-sent.json).
STOCK_TELEGRAM_ALERTS=true
# Topik forum khusus Stocks (dari link topik yang dibagikan user).
STOCK_TELEGRAM_TOPIC_ID=21458
# Ambang confidence minimum untuk dikirim (opsional, default 55):
# STOCK_TG_MIN_CONFIDENCE=55
# Jendela cooldown dedup dalam jam (opsional, default 12; minimum 0.5):
# STOCK_TG_COOLDOWN_HOURS=12
# Maksimum pesan per siklus dispatch (opsional, default 5):
# STOCK_TG_MAX_PER_CYCLE=5

# Override chatId (opsional, default -1004431059985 sudah hardcoded):
# TELEGRAM_CHAT_ID=-1004431059985

# ─── Smart-Wallet Radar (menu Meme's → WALLETS) ─────────────────────────────
# Tanpa key ini, section WALLETS memakai data DEMO (simulasi) dan tombol SALIN
# hanya menyalin placeholder pendek. Dengan key, wallet ditemukan dari transaksi
# SWAP on-chain Solana (Helius Enhanced Transactions) → alamat LENGKAP + PnL nyata.
# Dapatkan API key gratis: https://dashboard.helius.dev → API Keys (free tier 100k credits/bln).
HELIUS_API_KEY=

# Opsional: paksa mode. 'helius' = selalu asli (butuh key), 'simulated' = selalu demo.
# Kosongkan (default) = otomatis: pakai helius bila HELIUS_API_KEY terisi, selain itu demo.
SOLANA_WALLET_PROVIDER=
